# Web service config (apps/web). Copy to `.env.local` (git-ignored).

# Where the API backend lives. The browser reaches it via the /api/* rewrite
# (see next.config.ts); app/page.tsx also calls it directly for the auth gate.
BACKEND_URL=http://127.0.0.1:3011

# Port the web dev/start server binds to.
WEB_PORT=3010
