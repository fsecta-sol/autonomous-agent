# Server-side config for the agent service (apps/agent).
#
# The agent is stateless: the backend sends it everything a run needs (persona,
# tools, MCP servers, LLM credentials) in the /run payload. This file only holds
# what is environment-specific to the process itself.

# Root of the notes vault the vault_* tools read. Defaults to /home/hermes/vault.
VAULT_ROOT=/home/hermes/vault

# Where the backend's internal tool endpoints live (list_agents, knowledge_search).
BACKEND_INTERNAL_URL=http://127.0.0.1:3011

# Shared secret the agent presents to the backend's /internal/tools/* endpoints.
# Must equal INTERNAL_TOOL_TOKEN in the backend's env. When empty the backend
# refuses those endpoints.
INTERNAL_TOOL_TOKEN=

# Terminal tool. "unsandboxed" runs are refused unless this is 1; the backend
# also gates this per-request via the payload's allowUnsandboxed flag.
TERMINAL_ALLOW_UNSANDBOXED=0

# Port uvicorn binds to.
AGENT_PORT=8012
