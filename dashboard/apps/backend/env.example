# Backend service config (apps/backend). Copy to `.env.local` (git-ignored).

# Base URL of an OpenAI-compatible endpoint (no trailing /chat/completions).
# Used to resolve the model list and handed to the agent per run.
LLM_BASE_URL=https://api.openai.com/v1

# API key for that endpoint. When empty, the AI routes answer 501.
LLM_API_KEY=

# Default model id. LEAVE BLANK to auto-detect from the endpoint.
LLM_MODEL=

# Max concurrent upstream generations per server process.
LLM_MAX_CONCURRENCY=8

# SQLite database for sessions, messages, agents, skills, MCP servers, operators.
# Created + migrated on first use. Defaults to ./data/dashboard.db.
DATABASE_PATH=./data/dashboard.db

# Terminal gate: refuse unsandboxed agent runs unless this is 1.
TERMINAL_ALLOW_UNSANDBOXED=0

# Where the agent service lives, and the shared secret it presents to
# /internal/tools/*. The agent's INTERNAL_TOOL_TOKEN must match this exactly.
AGENT_URL=http://127.0.0.1:8012
INTERNAL_TOOL_TOKEN=

# Session cookie `Secure` flag. Unset: auto (Secure only when the request
# arrived over HTTPS, via x-forwarded-proto). Set to 1 to force Secure (behind
# a TLS terminator that strips the header), or 0 to force it off. Do NOT force
# Secure on a plain-HTTP deployment — the browser then refuses to send the
# cookie back and every request after login 401s.
# SESSION_COOKIE_SECURE=
